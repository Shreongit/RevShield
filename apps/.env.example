# WebShield Environment Configuration
PROJECT_NAME="WebShield"
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL in Docker, SQLite locally for dev)
DATABASE_URL="sqlite+aiosqlite:///./webshield.db"
# DATABASE_URL="postgresql+asyncpg://webshield:webshield_dev_password@localhost:5432/webshield"

# Redis & Celery Background Queue
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Safety Limits
REQUEST_TIMEOUT_SECONDS=8.0
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=5242880
ANALYSIS_CACHE_TTL_SECONDS=3600
